          {
           "type": "TEXT_NODE_TYPE_WORD",
           "word": {
            "words": "8处引用",
            "font_size": 17,
            "color": "#999999",
            "dark_color": "",
            "style": {
             "bold": false,
             "italic": false,
             "strikethrough": false,
             "underline": false,
